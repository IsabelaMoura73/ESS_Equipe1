# Supabase - ESS Equipe 1
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Conexao direta com o PostgreSQL do Supabase.
# Cole a URL completa quando tiver usuario/senha, por exemplo:
# postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Chave secreta service_role - Settings > API Keys > Secret keys no painel do Supabase
SUPABASE_SERVICE_KEY=
